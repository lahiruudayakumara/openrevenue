# Local development only. These values are intentionally fictional and must
# never be reused in shared, staging, or production environments.
OPENREVENUE_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://openrevenue:openrevenue_dev_only@localhost:5432/openrevenue?sslmode=disable
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=openrevenue-development
S3_ACCESS_KEY=openrevenue
S3_SECRET_KEY=openrevenue_dev_only
SMTP_ADDRESS=localhost:1025
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Pinned local service images.
POSTGRES_IMAGE=postgres:17.10-alpine
REDIS_IMAGE=redis:7.4.9-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MAILPIT_IMAGE=axllent/mailpit:v1.30.4
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.3.9
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.130.1

POSTGRES_DB=openrevenue
POSTGRES_USER=openrevenue
POSTGRES_PASSWORD=openrevenue_dev_only
MINIO_ROOT_USER=openrevenue
MINIO_ROOT_PASSWORD=openrevenue_dev_only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=openrevenue_dev_only
