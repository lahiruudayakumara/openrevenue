{
    "name": "openrevenue",
    "private": true,
    "packageManager": "pnpm@10.14.0",
    "engines": {
        "node": "22.23.1",
        "pnpm": "10.14.0"
    },
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "contracts": "spectral lint --fail-severity=warn --ruleset .spectral.yaml \"contracts/openapi/*.yaml\" && ajv compile --spec=draft2020 -c ajv-formats -s \"contracts/events/*.json\"",
        "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"web/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"web/**/*.{ts,tsx}\""
    },
    "devDependencies": {
        "@stoplight/spectral-cli": "6.15.0",
        "ajv-cli": "5.0.0",
        "ajv-formats": "3.0.1",
        "prettier": "^3.6.2",
        "turbo": "^2.5.5",
        "typescript": "^5.8.3"
    }
}
